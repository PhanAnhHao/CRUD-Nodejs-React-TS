{
  "name": "nodejs-ts",
  "version": "1.0.0",
  "description": "nodejs-ts",
  "main": "dist/app.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "tsc && node dist/app.js",
    "dev": "nodemon",
    "start:debug": "nodemon --inspect=9229 -e ts,tsx --exec node -r ts-node/register -r tsconfig-paths/register ./src/app.ts"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "ignore": [
      "node_modules"
    ],
    "exec": "ts-node -r tsconfig-paths/register ./src/app.ts"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "ts"
  ],
  "author": {
    "name": "PhAHao",
    "gitUrl": "https://github.com/PhanAnhHao"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.3.0",
    "@types/multer": "2.0.0",
    "bcrypt": "5.1.1",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "ejs": "3.1.10",
    "express": "5.0.1",
    "multer": "2.0.2",
    "mysql2": "3.12.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.0",
    "@types/node": "22.10.7",
    "nodemon": "3.1.9",
    "prisma": "6.3.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3"
  }
}
